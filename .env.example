# ─────────────────────────────────────────────────────────────────────────────
# XAI Learning Recommendation System — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (production / docker-compose)
# Leave blank for local dev outside Docker — stores use SQLite fallback.
DATABASE_URL=postgresql://xai:your_password_here@localhost:5432/xai_db

# Postgres credentials (used by docker-compose)
POSTGRES_USER=xai
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=xai_db

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_64_char_hex_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MIN=1440

# ── LLM Narration ─────────────────────────────────────────────────────────────
# Get from https://console.groq.com — free tier available
# Leave blank to disable LLM narration (explanations still work)
GROQ_API_KEY=groq_api_key_here

# ── AWS (S3 model artifacts) ──────────────────────────────────────────────────
# Leave blank for local dev — models loaded from local models/ directory
AWS_S3_BUCKET=xai-rec-models-001
AWS_REGION=ap-south-1
# AWS credentials — set these OR use IAM instance role on EC2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=./mlruns

# ── Frontend ──────────────────────────────────────────────────────────────────
# In production, the frontend is served from the same container as the API
# (FastAPI serves the built Vite output from backend/static/), so this should
# be left empty (relative URLs).
# Only set this if you are hosting the frontend separately from the API.
# Example: VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=

