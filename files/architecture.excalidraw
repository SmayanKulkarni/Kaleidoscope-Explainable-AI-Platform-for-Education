      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "Unique Signals for LLM Narrator\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nTreeSHAP: signed feature importance\nDeepSHAP: temporal attribution (6\u00d712)\nArchipelago: pairwise risk amplifiers\nAnchors: human-readable IF-THEN rules\nDiCE: concrete actionable targets\nPrototypes: relatable student stories",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el_0085",
      "originalText": "Unique Signals for LLM Narrator\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nTreeSHAP: signed feature importance\nDeepSHAP: temporal attribution (6\u00d712)\nArchipelago: pairwise risk amplifiers\nAnchors: human-readable IF-THEN rules\nDiCE: concrete actionable targets\nPrototypes: relatable student stories",
      "autoResize": true,
      "lineHeight": 1.25
    },
